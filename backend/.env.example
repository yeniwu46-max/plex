# ============ Flask 环境 ============
# 环境: development (开发) | testing (测试) | production (生产)
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=True

# ============ 数据库配置 ============
# MySQL 连接字符串
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/learning_system

# MySQL 连接详情（可选，备选方案）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=learning_system

# ============ JWT 认证密钥 ============
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-generate-it-yourself
JWT_SECRET_KEY=your-jwt-secret-key-generate-it-yourself

# ============ JWT 配置 ============
# Token过期时间（小时）
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ============ 服务器配置 ============
SERVER_HOST=0.0.0.0
SERVER_PORT=5100

# ============ AI 能力配置 ============
# 阿里百炼 API
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_MODEL=deepseek-v3

# DeepSeek（试炼编程辅导 / 驿站助手 / 补给站解析 / 教师 AI 出题）
DEEPSEEK_API_KEY=
DEEPSEEK_TRIAL_GEN_API_KEY=
DEEPSEEK_MESSENGER_API_KEY=
DEEPSEEK_EMERGENCY_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI / OpenRouter（CrewAI 多智能体与学习流水线 LLM 增强，可选）
# 通用 / AI 审核智能体
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 各流水线智能体独立 OpenAI Key（未填则回退 OPENAI_API_KEY）
OPENAI_PROFILE_INTERPRETER_API_KEY=
OPENAI_KNOWLEDGE_RETRIEVER_API_KEY=
OPENAI_INSTRUCTIONAL_DESIGNER_API_KEY=
OPENAI_PATH_PLANNER_API_KEY=
# 可选：各智能体独立模型名（默认共用 OPENAI_MODEL）
# OPENAI_PROFILE_INTERPRETER_MODEL=gpt-4o-mini
# OPENAI_KNOWLEDGE_RETRIEVER_MODEL=gpt-4o-mini
# OPENAI_INSTRUCTIONAL_DESIGNER_MODEL=gpt-4o-mini
# OPENAI_PATH_PLANNER_MODEL=gpt-4o-mini
# 审核智能体超时（秒）
RESOURCE_AI_REVIEW_TIMEOUT=25
# 画像解释 / 知识检索 / 教学设计 / 路径规划 智能体超时（秒）
RESOURCE_PIPELINE_AGENT_TIMEOUT=20
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AGENT_BACKEND=auto

# Neo4j 知识图谱（学习路径智能体）
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=plex-neo4j-dev

# 讯飞 Spark Lite HTTP OpenAI 兼容接口（驿站小E 流式/非流式均优先使用，再回落 DeepSeek）
# 方式一：合并凭证 apiKey:apiSecret（或控制台 APIPassword）
IFLYTEK_SPARK_CREDENTIALS=
# 方式二：拆分填写（与方式一选一）
IFLYTEK_SPARK_APP_ID=
IFLYTEK_SPARK_API_KEY=
# 方式三：控制台直接复制的 APIPassword
IFLYTEK_SPARK_API_PASSWORD=
IFLYTEK_SPARK_MODEL=lite
IFLYTEK_SPARK_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
# 试炼「小E帮分析」专用（优先）；留空则回落上方通用星火凭证
IFLYTEK_SPARK_TRIAL_CREDENTIALS=
IFLYTEK_SPARK_TRIAL_API_PASSWORD=
# 边界条件补给站智能出题专用（优先）；留空则回落上方通用星火凭证
IFLYTEK_SPARK_SUPPLY_CREDENTIALS=
IFLYTEK_SPARK_SUPPLY_API_PASSWORD=

# 讯飞星辰 Agent API（驿站助手备用；需发布为 API 后填写 flowId + key/secret）
XFYUN_AGENT_FLOW_ID=
XFYUN_AGENT_API_KEY=
XFYUN_AGENT_API_SECRET=
XFYUN_AGENT_BOT_ID=5709919
XFYUN_AGENT_URL=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
XFYUN_AGENT_USER_INPUT_KEY=AGENT_USER_INPUT
RESOURCE_TASK_SYNC=false

# ============ 外部 API 网络 ============
# LLM/多模态 API 的 HTTP 代理：留空自动读取 Windows 系统代理；
# 填 off 强制直连；也可显式填 http://127.0.0.1:7897
LLM_HTTP_PROXY=
# 外部 API 请求失败自动重试次数（代理冷启动首次请求常超时）
LLM_HTTP_RETRIES=1

# ============ 讯飞在线语音合成 TTS（语音讲解资源） ============
# 控制台 https://console.xfyun.cn/services/tts 获取
IFLYTEK_TTS_APP_ID=
IFLYTEK_TTS_API_KEY=
IFLYTEK_TTS_API_SECRET=
IFLYTEK_TTS_VOICE=xiaoyan

# ============ 火山方舟 Ark（教学视频 / 答疑图解生成，可选） ============
# 控制台 https://console.volcengine.com/ark 获取
# 也可用 OpenAI SDK：base_url=.../api/v3 + ARK_API_KEY
ARK_API_KEY=
# 视频生成模型 ID，例如 doubao-seedance-1-0-lite-t2v-250428
ARK_VIDEO_MODEL=
# 图像生成模型 ID（Seedream 5.0 Pro）
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
# 分辨率：2K / 1K / 2048x2048 等（Seedream 5 推荐 2K）
ARK_IMAGE_SIZE=2K
# 是否加水印（对应 images.generate extra_body.watermark）
ARK_IMAGE_WATERMARK=true
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 生成媒体文件存放目录（默认 backend/media）
# MEDIA_ROOT=

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============ CORS 配置 ============
CORS_ORIGINS=http://localhost:3000,http://localhost:5180

# ============ 第三方登录 OAuth ============
# Google/GitHub 控制台中的回调地址需分别配置为:
# http://127.0.0.1:5100/api/v1/auth/oauth/google/callback
# http://127.0.0.1:5100/api/v1/auth/oauth/github/callback
FRONTEND_BASE_URL=http://localhost:5180
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ============ 环境标记 ============
# 用于区分不同环境（可选）
ENVIRONMENT=development
VERSION=1.0.0
