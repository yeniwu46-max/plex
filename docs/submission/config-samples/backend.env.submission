# PLEX A3 提交包默认配置 — SQLite + 真实 API 接入（AGENT_BACKEND=auto）
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=True

DATABASE_URL=sqlite:///instance/learning_system.db

SECRET_KEY=submission-dev-secret-key-change-me-32b
JWT_SECRET_KEY=submission-dev-jwt-secret-key-change-me-32b
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

SERVER_HOST=0.0.0.0
SERVER_PORT=5100

# 多智能体：auto = 优先 CrewAI/LLM，不可用时走 Spark/DeepSeek，最后才规则兜底
AGENT_BACKEND=auto

# DeepSeek（试炼辅导 / 驿站 / 教师出题 / 流水线 LLM）
DEEPSEEK_API_KEY=
DEEPSEEK_TRIAL_GEN_API_KEY=
DEEPSEEK_MESSENGER_API_KEY=
DEEPSEEK_EMERGENCY_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI / OpenRouter（CrewAI 多智能体增强，可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# 讯飞 Spark Lite（资源生成 / 驿站优先）
IFLYTEK_SPARK_CREDENTIALS=
IFLYTEK_SPARK_MODEL=lite
IFLYTEK_SPARK_URL=https://spark-api-open.xf-yun.com/v1/chat/completions

# 讯飞星辰 Agent（小E 自由问答）
XFYUN_AGENT_FLOW_ID=
XFYUN_AGENT_API_KEY=
XFYUN_AGENT_API_SECRET=
XFYUN_AGENT_BOT_ID=5709919
XFYUN_AGENT_URL=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
XFYUN_AGENT_USER_INPUT_KEY=AGENT_USER_INPUT
RESOURCE_TASK_SYNC=false

NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=plex-neo4j-dev

CORS_ORIGINS=http://localhost:5180
FRONTEND_BASE_URL=http://localhost:5180

LOG_LEVEL=INFO
ENVIRONMENT=development
VERSION=1.0.0
